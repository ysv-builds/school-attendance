# Copy this file to ".env" and fill in the values.

PORT=3000
NODE_ENV=development          # use "production" when deployed behind HTTPS
JWT_SECRET=change-this-to-a-long-random-string
SCHOOL_NAME=Your School Name
DB_FILE=school.db

# Password for the first "admin" account (only used the very first time the app starts).
# If empty, a random password is printed in the console.
ADMIN_PASSWORD=

# SMS: console | fast2sms | msg91
SMS_PROVIDER=console

# Fast2SMS (DLT route)
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_MESSAGE_ID=

# MSG91 (Flow API)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
